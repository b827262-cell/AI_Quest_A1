# ============================================================
# AI-SmartBook-R1 root env example
# Do not commit real .env files.
# ============================================================

NODE_ENV=development

# Admin browser authentication. Use ADMIN_PASSWORD_HASH for production;
# ADMIN_PASSWORD is a local-development fallback only.
ADMIN_API_TOKEN=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_TTL_MS=28800000
ADMIN_SESSION_SECURE=true
ADMIN_ALLOWED_ORIGINS=http://127.0.0.1:5174,http://localhost:5174

# Admin AI provider. Default mock works without API key.
AI_PROVIDER=mock
AI_MODEL=gemini-3.5-flash
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=

# SQLite
DATABASE_URL=file:./data/ai-smartbook-r1.db
SQLITE_PATH=./data/ai-smartbook-r1.db

# Student runtime
STUDENT_GOOGLE_AUTH_ENABLED=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:4310/api/student/auth/google/callback
STUDENT_SESSION_SECRET=
STUDENT_SESSION_TTL_MS=28800000
STUDENT_OAUTH_STATE_TTL_MS=600000
STUDENT_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
STUDENT_AUTH_DB_PATH=./data/ai-smartbook-r1.db
STU_RUNTIME_MODE=remote-api
STU_DB_PATH=./data/ai-smartbook-r1.db
STU_REMOTE_API_BASE_URL=http://127.0.0.1:4321
STU_API_PORT=4310
STU_PUBLIC_DIR=./apps/AI-Stu-R1/dist
STU_UPLOAD_DIR=./uploads/books
STU_READONLY_MODE=true
STU_CHAT_MODE=keyword
