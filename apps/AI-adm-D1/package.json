{
  "name": "AI-adm-D1",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5174",
    "server:dev": "tsx src/server/index.ts",
    "server:build": "esbuild src/server/index.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist-server/admin-api.mjs --external:better-sqlite3 --external:pdf-parse --banner:js=\"import{createRequire as __cr}from'module';const require=__cr(import.meta.url);\"",
    "build": "vite build && node ../../scripts/sites-normalize-vite-output.mjs . ai_quest_a1_admin_sites",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "node --import ../../apps/AI-adm-D1/node_modules/tsx/dist/loader.mjs ../../scripts/lint.mjs --scope=."
  },
  "dependencies": {
    "@ai-smartbook/auth": "workspace:*",
    "@ai-smartbook/ai": "workspace:*",
    "@ai-smartbook/book-core": "workspace:*",
    "@ai-smartbook/db": "workspace:*",
    "@ai-smartbook/schema": "workspace:*",
    "@ai-smartbook/ui": "workspace:*",
    "better-sqlite3": "latest",
    "express": "^4.19.2",
    "multer": "^1.4.5-lts.1",
    "pdf-parse": "latest",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0",
    "zod": "latest"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@openai/sites-vite-plugin": "0.1.0",
    "@types/express": "latest",
    "@types/multer": "latest",
    "@types/node": "latest",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "latest",
    "esbuild": "latest",
    "supertest": "^7.2.2",
    "tsx": "latest",
    "typescript": "latest",
    "vite": "latest",
    "wrangler": "4.92.0"
  }
}
