# AI_Quest_A1 Isolated Security Test Environment Variables
# Copy to .env.test for isolated local test runs (NEVER use production credentials)

NODE_ENV=test
PORT=3102
STUDENT_PORT=3103

# Isolated Test Database Path
DATABASE_URL=file:./data/test-isolated-security.db

# Synthetic Admin Auth Credentials (Test-only)
ADMIN_API_TOKEN=synthetic_test_admin_token_valid_9999
ADMIN_DEV_PASSWORD=test_admin_password_123

# AES Key for Credential Encryption Test Harness (Must be 32 hex chars / 256 bits)
AI_CREDENTIAL_ENCRYPTION_KEY=00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff

# Isolated Local Mock Provider Settings
MOCK_AI_PROVIDER_ENABLED=true
QM_BASE_URL=http://localhost:3102/api/mock-qm
