# QM deployment secret catalog. Names only; never commit values.
HARNESS=pi
HARNESS_SECURITY_POSTURE=auto
ORG_ID=ai-quest-a1
PORT=8080

# Required names are documented without values or credential-shaped
# placeholders. Put actual values only in the ignored deploy/qm/.env (mode
# 600). See docs/ops/qm-installation-and-local-run.md before remediation.
# External provider credential: ANTHROPIC_API_KEY
# Sandbox-reachable QM Core URL: PUBLIC_API_URL
# Independently generated local secrets: CORE_SIGNING_SECRET,
# CAPABILITY_SECRET, PORTAL_IDENTITY_SECRET, CONNECTOR_SECRET_KEY,
# SKILL_SIGNING_SECRET

RATE_LIMIT_PER_WINDOW=60
RATE_LIMIT_WINDOW_MS=60000
BUDGET_USD_PER_WINDOW=25
ORG_BUDGET_USD_PER_WINDOW=100
BUDGET_WINDOW_MS=86400000
