NODE_ENV=production
ADMIN_API_HOST=127.0.0.1
ADMIN_API_PORT=4300

# Formal browser authentication: use a generated scrypt hash, never a
# plaintext password, in production.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECURE=true
ADMIN_SESSION_TTL_MS=28800000
ADMIN_ALLOWED_ORIGINS=https://admin.example.com

# Optional CLI/internal automation credential. Keep it in this protected
# systemd environment only; never put it in VITE_* or a reverse-proxy header.
ADMIN_API_TOKEN=

# Student Google OAuth/session boundary. These values stay in this protected
# server environment; they are never VITE_* variables or browser responses.
STUDENT_GOOGLE_AUTH_ENABLED=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://student.example.com/api/student/auth/google/callback
STUDENT_SESSION_SECRET=
STUDENT_SESSION_TTL_MS=28800000
STUDENT_OAUTH_STATE_TTL_MS=600000
STUDENT_ALLOWED_ORIGINS=https://student.example.com
STUDENT_AUTH_DB_PATH=/opt/AI-Quest-A1/data/ai-smartbook-r1.db

AI_CREDENTIAL_ENCRYPTION_KEY=
SQLITE_PATH=/opt/AI-Quest-A1/data/ai-smartbook-r1.db
UPLOAD_DIR=/opt/AI-Quest-A1/uploads
