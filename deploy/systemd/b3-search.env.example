# /etc/b3-search-api/search.env  (mode 600, root-owned)
# Must be a READ-ONLY PostgreSQL role on the B2 iBrain database; the service
# refuses to start without it. Requires the `psql` client on PATH.
DATABASE_URL=postgresql://<readonly_user>:<password>@127.0.0.1:5432/<b2_database>
B3_SEARCH_HOST=127.0.0.1
B3_SEARCH_PORT=4360
