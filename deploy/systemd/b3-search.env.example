# /etc/b3-search-api/search.env  (mode 600, root-owned)
# Default: serve the validated 16-row B1 snapshot; no database needed.
B3_SEARCH_STORE=snapshot
B3_SEARCH_HOST=127.0.0.1
# Other hosts are refused unless B3_SEARCH_ALLOW_NON_LOOPBACK=1 is explicitly set.
# Keep the default loopback binding for nginx / Cloudflare Tunnel deployments.
B3_SEARCH_PORT=4360
# To use a live B2 PostgreSQL instead, set a READ-ONLY role here (this takes
# precedence over B3_SEARCH_STORE) and make sure `psql` is on PATH:
# DATABASE_URL=postgresql://<readonly_user>:<password>@127.0.0.1:5432/<b2_database>
