# Example only; do not install until the scheduler time zone is verified.
# CRON_TZ requires a cron implementation that supports it (for example cronie).
# Otherwise the host scheduler must use Asia/Taipei, or use a systemd timer.
# /etc/a01-nightly/slack.env must be owner-only (0600) and contain only Slack keys.
CRON_TZ=Asia/Taipei
50 23 * * * cd /opt/AI-Quest-A1 && /usr/bin/node scripts/a01-nightly-round.mjs --execute --env-file /etc/a01-nightly/slack.env >> /var/log/a01-nightly-round.log 2>&1
20,50 0-8 * * * cd /opt/AI-Quest-A1 && /usr/bin/node scripts/a01-nightly-round.mjs --execute --env-file /etc/a01-nightly/slack.env >> /var/log/a01-nightly-round.log 2>&1
